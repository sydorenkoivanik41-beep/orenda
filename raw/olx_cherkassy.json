ка, а магазини знаходяться прямо на першому поверсі будинку.<br />\n<br />\nБезпека: закритий двір із системою пропусків, чистий під'їзд із домофоном та кодовим замком.<br />\n<br />\nУмови оренди:<br />\n<br />\nІз задоволенням здамо квартиру порядним людям (чудово підійде для родини з 3-х осіб, подружньої пари з дитиною].<br />\n <br />\nПри всій любові до тваринок, змушені здавати житло без домашніх улюбленців. Сподіваємося на ваше розуміння.<br />\n<br />\nКвартира здається без посередників. Шановних рієлторів просимо не турбувати.","business":false,"user":{"id":2096237537},"category":{"id":1760},"location":{"city":{"id":145},"district":null},"photos":[{"link":"https://ireland.apollo.olxcdn.com:443/v1/files/62qxqf7wafkg3-UA/image;s={width}x{height}"},{"link":"https://ireland.apollo.olxcdn.com:443/v1/files/qt9zu9ayfh0c2-UA/image;s={width}x{height}"},{"link":"https://ireland.apollo.olxcdn.com:443/v1/files/il60qig94dik3-UA/image;s={width}x{height}"},{"link":"https://ireland.apollo.olxcdn.com:443/v1/files/bg94kwxe0gpo1-UA/image;s={width}x{height}"},{"link":"https://ireland.apollo.olxcdn.com:443/v1/files/4woe32ouur2t2-UA/image;s={width}x{height}"}],"created_time":"2026-10-05T13:41:54+03:00","last_refresh_time":"2026-10-05T13:55:07+03:00","params":[{"key":"price","value":{"label":"20 000 грн.","value":20000,"currency":"UAH","converted_value":null}},{"key":"commission","value":{"key":"1","label":"Без комісії"}},{"key":"floor","value":{"key":"2","label":"2"}},{"key":"total_floors","value":{"key":"5","label":"5"}},{"key":"total_area","value":{"key":"55.3","label":"55.30 м²"}},{"key":"number_of_rooms_string","value":{"key":"trehkomnatnye","label":"3 кімнати"}},{"key":"furnish","value":{"key":"yes","label":"З меблями"}},{"key":"appliances_2","value":{"key":["electric_kettle","fridge","hob"],"label":"Електрочайник, Холодильник, Варильна панель"}},{"key":"additional","value":{"key":["only_family"],"label":"Тільки сім'ям"}}]},{"id":936363742,"url":"https://www.olx.ua/d/uk/oby